// Prisma schema for Corporate Employee Induction LMS
// Designed for MS SQL Server & SQLite multi-database compatibility

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model HRUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Hashed with bcrypt
  name      String
  email     String   @unique
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs ActivityLog[]

  @@map("HRUsers")
}

model Employee {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  firstName   String
  middleName  String?
  lastName    String
  email       String   @unique
  department  String
  designation String
  office      String
  joiningDate DateTime
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessonProgresses   LessonProgress[]
  assessmentAttempts AssessmentAttempt[]
  certificates       Certificate[]
  activityLogs       ActivityLog[]

  @@index([employeeId])
  @@index([department])
  @@index([status])
  @@map("Employees")
}

model Course {
  id           String   @id @default(cuid())
  title        String
  description  String?
  code         String   @unique
  passingScore Float    @default(80.0) // Percentage required to pass assessment
  isPublished  Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules             Module[]
  assessmentQuestions AssessmentQuestion[]
  assessmentAttempts  AssessmentAttempt[]
  certificates        Certificate[]

  @@map("Courses")
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  sortOrder   Int      @default(0)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@index([sortOrder])
  @@map("Modules")
}

model Lesson {
  id                 String   @id @default(cuid())
  moduleId           String
  title              String
  description        String?
  contentType        String   @default("VIDEO") // VIDEO, PDF, VIDEO_PDF
  videoUrl           String?  // SharePoint Video URL / File ID
  pdfUrl             String?  // SharePoint PDF URL / File ID
  sortOrder          Int      @default(0)
  minDurationSeconds Int      @default(0)
  isDeleted          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgresses LessonProgress[]

  @@index([moduleId])
  @@index([sortOrder])
  @@map("Lessons")
}

model LessonProgress {
  id                   String    @id @default(cuid())
  employeeId           String
  lessonId             String
  isCompleted          Boolean   @default(false)
  watchedSeconds       Float     @default(0)
  totalSeconds         Float     @default(0)
  watchedIntervalsJSON String    @default("[]") // JSON string of [[start, end], ...] segments watched
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([employeeId, lessonId])
  @@index([employeeId])
  @@index([lessonId])
  @@map("LessonProgress")
}

model AssessmentQuestion {
  id                 String   @id @default(cuid())
  courseId           String
  questionText       String
  optionsJSON        String   // JSON string of options array ["Opt A", "Opt B", ...]
  correctOptionIndex Int      // 0-indexed correct option
  explanation        String?
  points             Float    @default(1.0)
  sortOrder          Int      @default(0)
  isDeleted          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("AssessmentQuestions")
}

model AssessmentAttempt {
  id               String   @id @default(cuid())
  employeeId       String
  courseId         String
  score            Float    // Score percentage (e.g. 85.5)
  passed           Boolean
  totalQuestions   Int
  correctAnswers   Int
  timeTakenSeconds Int
  startedAt        DateTime @default(now())
  submittedAt      DateTime @default(now())
  answersJSON      String   // JSON map of { [questionId]: selectedOptionIndex }

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([courseId])
  @@map("AssessmentAttempts")
}

model Certificate {
  id                 String   @id @default(cuid())
  employeeId         String
  courseId           String
  certificateNumber  String   @unique
  issueDate          DateTime @default(now())
  qrVerificationCode String   @unique
  pdfPath            String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([employeeId, courseId])
  @@index([certificateNumber])
  @@index([qrVerificationCode])
  @@map("Certificates")
}

model ActivityLog {
  id         String    @id @default(cuid())
  userId     String?   // Employee ID or HR User ID
  employeeId String?   // Relational FK to Employee if applicable
  hrUserId   String?   // Relational FK to HRUser if applicable
  role       String    // HR_ADMIN or EMPLOYEE
  action     String    // LOGIN, LOGOUT, LESSON_STARTED, LESSON_COMPLETED, ASSESSMENT_STARTED, ASSESSMENT_SUBMITTED, CERTIFICATE_DOWNLOADED, TAB_SWITCH, FULLSCREEN_EXIT, WINDOW_BLUR
  details    String?   // JSON or text description
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  hrUser   HRUser?   @relation(fields: [hrUserId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([action])
  @@index([createdAt])
  @@map("ActivityLogs")
}
